{
  "mart": "mart_daily_branch_openings",
  "version": 1,
  "reverts_to": null,
  "requested_by": "requester1",
  "requirements": [
    {"id": "R-01", "text": "개설일별 신규 지점 개설 건수(new_branch_cnt)를 일자별 전국 1행으로 만든다", "section": 3},
    {"id": "R-02", "text": "본점, 모든 사무소 유형, 1900년 이전 개설일을 제외하지 않고 센다", "section": 3},
    {"id": "R-03", "text": "개설이 있는 날짜만 행으로 만든다 (0건인 날짜는 행 없음)", "section": 9},
    {"id": "R-04", "text": "mart 건수 합계와 행 수가 원천과 오차 0으로 일치한다", "section": 4},
    {"id": "R-05", "text": "stg의 지점 키는 고유하고 개설일에 NULL이 없다", "section": 4},
    {"id": "R-06", "text": "같은 날짜로 2회 연속 실행해도 결과가 같다", "section": 7}
  ],
  "sources": [
    "bigquery-public-data.fdic_banks.locations"
  ],
  "load": {"mode": "snapshot"},
  "interview": {
    "metrics": [
      {
        "name": "new_branch_cnt",
        "formula": "개설일(date_established)이 같은 사무소의 branch_fdic_uninum 고유 개수",
        "unit": "건",
        "base_date": "개설일 (established_date)",
        "exclude": "없음. 본점(main_office TRUE), 모든 service_type, 1900년 이전 개설일 모두 포함",
        "numerator": null,
        "denominator": null
      }
    ],
    "grain": "mart는 한 snapshot_date 파티션 안에서 개설일 1일 = 1행 (개설이 있는 날짜만). stg는 지점 1곳 = 1행",
    "keys": ["snapshot_date", "established_date"],
    "assumptions": [
      "지점 1곳의 식별자는 branch_fdic_uninum이다 (81496건 모두 고유, NULL 0건)",
      "개설일은 date_established이고 NULL이 없어 제외·대체 규칙이 필요 없다",
      "원천은 2022-10 이후 갱신되지 않아 매일 같은 값이 쌓인다. snapshot_date는 실행일이며 개설일과 무관하다",
      "원천의 모든 행은 사무소 1곳이며 같은 사무소가 중복 행으로 들어 있지 않다",
      "0건인 날짜는 행을 만들지 않는다 (요청자 답변)"
    ],
    "out_of_scope": [
      "주·도시·기관별 등 차원 분해",
      "폐점·이전·합병 추적",
      "개설이 없는 날짜를 0건으로 채우는 달력 보정",
      "지점 주소·기관명 등 상세 컬럼의 stg·mart 전달"
    ]
  },
  "tables": [
