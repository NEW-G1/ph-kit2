      {"id": "stg_branch_opening", "kind": "load", "layer": "stg", "upstream": ["gate_raw_mart_daily_branch_openings"]},
      {"id": "gate_stg_mart_daily_branch_openings", "kind": "gate", "layer": "stg", "upstream": ["stg_branch_opening"]},
      {"id": "mart_daily_branch_openings", "kind": "load", "layer": "mart", "upstream": ["gate_stg_mart_daily_branch_openings"]},
      {"id": "gate_mart_mart_daily_branch_openings", "kind": "gate", "layer": "mart", "upstream": ["mart_daily_branch_openings"]}
    ]
