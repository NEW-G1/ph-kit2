        {"name": "cbsa_metro_fips_code", "name_ko": "대도시권 FIPS 코드", "type": "STRING", "description": "대도시 통계 지역 코드"},
        {"name": "cbsa_metro_name", "name_ko": "대도시권 이름", "type": "STRING", "description": "대도시 통계 지역 이름"},
