      {"id": "C-01", "rule": "raw_locations 당일 파티션에 행이 1개 이상 존재한다", "rung": "L3", "written_by": "verifier"},
      {"id": "C-02", "rule": "stg_branch_opening의 branch_fdic_uninum은 당일 파티션 안에서 고유하고 NULL이 없다", "rung": "L3", "written_by": "verifier"},
      {"id": "C-03", "rule": "stg_branch_opening의 established_date에 NULL이 없다", "rung": "L3", "written_by": "verifier"},
      {"id": "C-04", "rule": "mart_daily_branch_openings의 established_date는 당일 파티션 안에서 고유하다", "rung": "L3", "written_by": "verifier"},
      {"id": "C-05", "rule": "mart_daily_branch_openings의 new_branch_cnt는 모든 행에서 1 이상이다", "rung": "L3", "written_by": "verifier"}
    ],
    "reconciliation": [
      {"id": "C-06", "rule": "stg_branch_opening 당일 행 수는 원천 locations 행 수와 같다 (오차 0)", "rung": "L4", "written_by": "verifier"},
      {"id": "C-07", "rule": "mart_daily_branch_openings의 new_branch_cnt 합계는 원천 locations 행 수와 같다 (오차 0)", "rung": "L4", "written_by": "verifier"},
      {"id": "C-08", "rule": "mart_daily_branch_openings 당일 행 수는 원천 date_established의 서로 다른 날짜 수와 같다 (오차 0)", "rung": "L4", "written_by": "verifier"},
      {"id": "C-09", "rule": "mart_daily_branch_openings의 날짜별 new_branch_cnt는 원천에서 date_established별로 센 branch_fdic_uninum 고유 개수와 모든 날짜에서 같다", "rung": "L4", "written_by": "verifier"}
    ],
    "invariants": [
      {"id": "I-01", "rule": "mart_daily_branch_openings의 established_date 최솟값과 최댓값은 원천 date_established의 최솟값과 최댓값과 같다 (날짜 필터가 없다는 확인)", "rung": "L4", "written_by": "verifier"},
      {"id": "I-02", "rule": "같은 ds로 2회 연속 실행한 뒤 mart_daily_branch_openings의 행 수와 new_branch_cnt 체크섬이 같다", "rung": "L5", "written_by": "verifier"}
    ]
  },
